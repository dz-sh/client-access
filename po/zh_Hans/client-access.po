#, javascript-format
msgid "%d hours"
msgstr "%d 小时"

#, javascript-format
msgid "%d hours %d minutes"
msgstr "%d 小时 %d 分钟"

#, javascript-format
msgid "%d minutes"
msgstr "%d 分钟"

#, javascript-format
msgid "%d seconds"
msgstr "%d 秒"

msgid "A broad category provides a safe fallback when evidence cannot identify the exact application."
msgstr "当证据无法识别具体应用时，使用较宽泛的类别作为安全的回退结果。"

msgid "A custom flow-offload topology is present and is not supported."
msgstr "检测到不受支持的自定义流量卸载拓扑。"

msgid "A restrictive change is published first, then matching accelerated flows are removed and verified. This is bounded revocation, not instant or zero-packet termination."
msgstr "限制性变更会先发布策略，再删除并验证匹配的加速流。这是有界撤销，不保证即时或零数据包终止。"

#, javascript-format
msgid "A runtime-only approval overrides the base result until %s."
msgstr "仅运行时有效的授权将覆盖基础结果，直到 %s。"

msgid "A stable numeric key used only by the application workflow. Avoid changing it while active flows exist."
msgstr "仅供应用过滤流程使用的稳定数字键。存在活跃流时请勿修改。"

msgid "Action"
msgstr "操作"

msgid "Add MAC address"
msgstr "添加 MAC 地址"

msgid "Add application or category"
msgstr "添加应用或类别"

msgid "Add application rule"
msgstr "添加应用规则"

msgid "Add at least one weekly period when Apply policy is On schedule."
msgstr "当“应用策略”为“按时间表”时，请至少添加一个每周时段。"

msgid "Add at least one weekly period when Apply rule is On schedule."
msgstr "当“应用规则”为“按时间表”时，请至少添加一个每周时段。"

msgid "Add identity"
msgstr "添加身份"

msgid "Add one or more periods. Use all-day for the whole day. A period such as 22:00-07:00 ends the next day."
msgstr "添加一个或多个时段。全天请使用 all-day。22:00-07:00 这类时段会在次日结束。"

msgid "Add to existing identity"
msgstr "添加到现有身份"

msgid "Adds a separate application-filter layer for managed identities. It remains independent from the nftables Internet access result. Canonical firewall4 software flow offload is supported when the optional BPF and SFO packages are installed; hardware and custom offload are not supported."
msgstr "为受管身份添加独立的应用过滤层。它与 nftables 互联网访问结果相互独立。安装可选的 BPF 和 SFO 包后支持标准 firewall4 软件流量卸载；不支持硬件和自定义卸载。"

msgid "Advanced settings"
msgstr "高级设置"

msgid "All other applications"
msgstr "所有其他应用"

msgid "Allow"
msgstr "允许"

msgid "Allow packets during the initial classification window"
msgstr "在初始分类窗口期间允许数据包"

msgid "Allow selected clients"
msgstr "允许选中的客户端"

msgid "Allowed"
msgstr "已允许"

msgid "Allowed now"
msgstr "当前允许"

msgid "Always"
msgstr "始终"

msgid "Application"
msgstr "应用"

msgid "Application and category catalog"
msgstr "应用与类别目录"

msgid "Application authorization remains independent from the nftables Internet access policy."
msgstr "应用授权始终与 nftables 互联网访问策略相互独立。"

msgid "Application classification is one-packet best effort. This is suitable for parental controls, not zero-leak security enforcement."
msgstr "应用分类对单个数据包尽力而为。这适合家长控制，不适合要求零泄漏的安全强制。"

msgid "Application diagnostics"
msgstr "应用过滤诊断"

msgid "Application filtering"
msgstr "应用过滤"

msgid "Application filtering is active for managed identities."
msgstr "应用过滤已对受管身份生效。"

msgid "Application filtering is degraded; see diagnostics before relying on its rules."
msgstr "应用过滤已降级；依赖其规则前请查看诊断信息。"

msgid "Application filtering is off. The nftables Internet access policy remains independent."
msgstr "应用过滤已关闭。nftables 互联网访问策略仍独立运行。"

msgid "Application or category"
msgstr "应用或类别"

msgid "Application rules"
msgstr "应用规则"

msgid "Application-layer result"
msgstr "应用层结果"

#, javascript-format
msgid "Application: %s"
msgstr "应用：%s"

msgid "Apply pending configuration before creating an approval."
msgstr "创建授权前，请先应用待处理的配置。"

msgid "Apply policy"
msgstr "应用策略"

msgid "Apply policy: Never. Creating this identity will not change its Internet access until you edit it."
msgstr "应用策略：从不。在您编辑前，创建此身份不会改变其互联网访问。"

msgid "Apply rule"
msgstr "应用规则"

msgid "Apply the pending configuration to calculate the current result."
msgstr "应用待处理的配置后才能计算当前结果。"

msgid "Approve for 1 hour"
msgstr "授权 1 小时"

msgid "Approve today"
msgstr "授权至今日结束"

msgid "Backend"
msgstr "后端"

msgid "Backend schema"
msgstr "后端模式"

#, javascript-format
msgid "Base: %s"
msgstr "基础结果：%s"

#, javascript-format
msgid "Base: %s · Effective: %s"
msgstr "基础结果：%s · 有效结果：%s"

msgid "Base: Blocked · Temporary approval changes only the runtime result and does not edit the saved rule."
msgstr "基础结果：已阻止 · 临时授权仅改变运行时结果，不修改已保存规则。"

msgid "Block"
msgstr "阻止"

msgid "Block in the application layer"
msgstr "在应用层阻止"

msgid "Block selected clients"
msgstr "阻止选中的客户端"

msgid "Blocked"
msgstr "已阻止"

msgid "Blocked now"
msgstr "当前阻止"

msgid "Cancel"
msgstr "取消"

msgid "Category"
msgstr "类别"

msgid "Choose one Internet access policy, then choose when it applies to each identity."
msgstr "选择一项互联网访问策略，然后为每个身份选择它的生效时间。"

msgid "Choose when the selected global policy applies to this identity."
msgstr "选择已选全局策略对此身份的生效时间。"

#, javascript-format
msgid "Class %s"
msgstr "类别 %s"

msgid "Classification evidence"
msgstr "分类证据"

msgid "Classification is best effort. Domains and IP prefixes may identify an application; port-only evidence identifies only a category. Conflicting evidence becomes unclassified."
msgstr "分类仅尽力而为。域名和 IP 前缀可能识别具体应用；仅端口证据只能识别类别。证据冲突时将视为未分类。"

msgid "Classifier coverage"
msgstr "分类器覆盖率"

msgid "Client Access"
msgstr "客户端访问控制"

msgid "Clients"
msgstr "客户端"

msgid "Clients without an identity"
msgstr "未建立身份的客户端"

msgid "Control is off"
msgstr "控制已关闭"

msgid "Create a persistent identity for this detected MAC address. The detected name is only a suggestion."
msgstr "为检测到的此 MAC 地址创建持久身份。检测到的名称仅作为建议。"

msgid "Create an identity before adding application rules."
msgstr "添加应用规则前请先创建身份。"

msgid "Create identity"
msgstr "创建身份"

msgid "Current result"
msgstr "当前结果"

msgid "DNS correlation"
msgstr "DNS 关联"

msgid "DNS events accepted / dropped"
msgstr "DNS 事件已接受 / 已丢弃"

msgid "Detected LAN devices"
msgstr "检测到的 LAN 设备"

msgid "Detected MAC address"
msgstr "检测到的 MAC 地址"

msgid "Detected client"
msgstr "检测到的客户端"

msgid "Detected name"
msgstr "检测到的名称"

msgid "Diagnostics"
msgstr "诊断"

msgid "Domains"
msgstr "域名"

msgid "Each rule belongs to an identity and produces only an application-layer verdict. Inactive rules are saved as presets."
msgstr "每条规则都属于一个身份，且只产生应用层判定。不活跃的规则会作为预设保存。"

#, javascript-format
msgid "Effective: %s"
msgstr "有效结果：%s"

msgid "Enable and apply Internet access control before creating an access approval."
msgstr "创建访问授权前，请先启用并应用互联网访问控制。"

msgid "Enable and apply application filtering before creating an application approval."
msgstr "创建应用授权前，请先启用并应用应用过滤。"

msgid "Enable application filtering"
msgstr "启用应用过滤"

msgid "Enter a domain such as video.example or *.video.example."
msgstr "输入域名，例如 video.example 或 *.video.example。"

msgid "Enter a time period such as 08:00-12:00, or all-day."
msgstr "输入时段，例如 08:00-12:00 或 all-day。"

msgid "Exact / category"
msgstr "精确 / 类别"

msgid "Expires"
msgstr "到期时间"

#, javascript-format
msgid "Expires: %s (%s remaining)"
msgstr "到期：%s（剩余 %s）"

msgid "Failures"
msgstr "失败"

msgid "Flow map"
msgstr "流映射"

msgid "Flow-offload state is unknown."
msgstr "流量卸载状态未知。"

msgid "Friday"
msgstr "星期五"

msgid "Hours must be 00-23 and minutes must be 00-59."
msgstr "小时必须在 00-23 之间，分钟必须在 00-59 之间。"

msgid "IP addresses"
msgstr "IP 地址"

msgid "IPv4 prefixes"
msgstr "IPv4 前缀"

msgid "IPv6 prefixes"
msgstr "IPv6 前缀"

msgid "Identity"
msgstr "身份"

msgid "Internet access"
msgstr "互联网访问"

msgid "Internet access control is off."
msgstr "互联网访问控制已关闭。"

msgid "Internet access control is off. All clients can access the Internet."
msgstr "互联网访问控制已关闭。所有客户端均可访问互联网。"

msgid "Internet access policy"
msgstr "互联网访问策略"

msgid "Internet firewall zones"
msgstr "互联网防火墙区域"

msgid "LAN firewall zones"
msgstr "LAN 防火墙区域"

msgid "Last revocation"
msgstr "上次撤销"

msgid "Latency / deadline"
msgstr "延迟 / 截止时间"

msgid "Latest authorization transition"
msgstr "最近的授权转换"

msgid "License"
msgstr "许可证"

msgid "MAC address"
msgstr "MAC 地址"

msgid "MAC addresses"
msgstr "MAC 地址"

msgid "Manage as new identity"
msgstr "作为新身份管理"

msgid "Managed"
msgstr "受管"

msgid "Managed identities"
msgstr "受管身份"

msgid "Maximum time in milliseconds for deleting and verifying stale software-accelerated flows after a restrictive policy change."
msgstr "限制性策略变更后，删除并验证过期软件加速流所允许的最长时间（毫秒）。"

msgid "Mode / correlation"
msgstr "模式 / 关联"

msgid "Monday"
msgstr "星期一"

msgid "Name"
msgstr "名称"

msgid "Names and IP addresses are best-effort discovery information. A recognized MAC can remain configured when it is not currently detected."
msgstr "名称和 IP 地址是尽力探测的信息。已识别的 MAC 即使当前未被检测到，仍可保留在配置中。"

msgid "Never"
msgstr "从不"

msgid "New-flow behavior"
msgstr "新流行为"

msgid "Next change"
msgstr "下次变更"

msgid "Next policy change"
msgstr "下次策略变更"

msgid "No category"
msgstr "无类别"

msgid "No recognized MAC addresses."
msgstr "没有已识别的 MAC 地址。"

msgid "No scheduled change"
msgstr "没有计划的变更"

msgid "No temporary approvals are active."
msgstr "当前没有生效的临时授权。"

msgid "No terminal flows yet"
msgstr "尚无已完成分类的流"

msgid "No unknown clients detected"
msgstr "未检测到未知客户端"

msgid "Not currently detected"
msgstr "当前未检测到"

msgid "Not required"
msgstr "不需要"

msgid "Off"
msgstr "关闭"

msgid "Off allows every client. Block selected clients allows everyone else. Allow selected clients blocks everyone else, including unknown clients."
msgstr "“关闭”允许所有客户端。“阻止选中的客户端”会允许其他客户端。“允许选中的客户端”会阻止其他所有客户端，包括未知客户端。"

msgid "On schedule"
msgstr "按时间表"

msgid "Packets still pass the application layer while a new flow is pending. One early packet is inspected, so a denied application has a small initial leakage window."
msgstr "新流等待分类时，数据包仍会通过应用层。系统仅检查一个早期数据包，因此被拒绝的应用存在很小的初始泄漏窗口。"

msgid "Parent category"
msgstr "上级类别"

msgid "Pass the application layer"
msgstr "通过应用层"

msgid "Pending"
msgstr "待处理"

msgid "Policy"
msgstr "策略"

msgid "Policy / classifier generation"
msgstr "策略 / 分类器世代"

msgid "Profile metadata"
msgstr "配置档元数据"

msgid "Profile schema"
msgstr "配置档模式"

msgid "Profiles / normalized evidence"
msgstr "配置档 / 标准化证据"

msgid "Provenance"
msgstr "来源"

msgid "Reapply policy"
msgstr "重新应用策略"

msgid "Recognized MAC address"
msgstr "已识别的 MAC 地址"

msgid "Recognized MAC addresses"
msgstr "已识别的 MAC 地址"

msgid "Refresh"
msgstr "刷新"

msgid "Reject the connection"
msgstr "拒绝连接"

msgid "Remaining"
msgstr "剩余时间"

msgid "Result"
msgstr "结果"

msgid "Revoke"
msgstr "撤销"

msgid "Revoke now"
msgstr "立即撤销"

msgid "Rule"
msgstr "规则"

msgid "Saturday"
msgstr "星期六"

msgid "Scope"
msgstr "作用范围"

msgid "Selected now"
msgstr "当前已选中"

msgid "Semantic / runtime entries"
msgstr "语义 / 运行时条目"

msgid "Service is unavailable"
msgstr "服务不可用"

msgid "Set 1 hour from now"
msgstr "设为从现在起 1 小时"

msgid "Set until today ends"
msgstr "设为到今日结束"

msgid "Signature table estimate"
msgstr "特征表估算"

msgid "Silently drop traffic"
msgstr "静默丢弃流量"

msgid "Software flow offload is active with bounded revocation."
msgstr "软件流量卸载已启用，并支持有界撤销。"

msgid "Software flow offload is degraded; stale accelerated traffic may exceed the revocation deadline."
msgstr "软件流量卸载已降级；过期加速流量可能超过撤销截止时间。"

msgid "Software flow offload is enabled, but the optional revocation package is missing."
msgstr "软件流量卸载已启用，但缺少可选的撤销包。"

msgid "Software flow offload is off."
msgstr "软件流量卸载已关闭。"

msgid "Software flow offload is off; bounded-revocation support is installed."
msgstr "软件流量卸载已关闭；有界撤销支持已安装。"

msgid "Software offload diagnostics"
msgstr "软件卸载诊断"

msgid "Software offload revocation deadline"
msgstr "软件卸载撤销截止时间"

msgid "Source"
msgstr "来源"

msgid "Stable Profile ID"
msgstr "稳定配置档 ID"

msgid "Stable class ID"
msgstr "稳定类别 ID"

msgid "Subscribed"
msgstr "已订阅"

msgid "Sunday"
msgstr "星期日"

msgid "TCP destination ports"
msgstr "TCP 目标端口"

msgid "Targeted / fallback revocations"
msgstr "定向 / 回退撤销"

msgid "Temporary Internet approval"
msgstr "临时互联网授权"

msgid "Temporary application approval"
msgstr "临时应用授权"

msgid "Temporary approval active"
msgstr "临时授权已生效"

msgid "Temporary approval is intentionally unavailable for default and unclassified traffic."
msgstr "默认和未分类流量不提供临时授权，这是有意的设计。"

msgid "Temporary approvals"
msgstr "临时授权"

msgid "The active flow-offload topology could not be verified."
msgstr "无法验证当前的流量卸载拓扑。"

msgid "The base policy already allows this target, so a temporary approval would not change access."
msgstr "基础策略已允许此目标，因此临时授权不会改变访问结果。"

msgid "The configured Internet access policy is active."
msgstr "已配置的互联网访问策略正在生效。"

msgid "The current result is fail-closed because this identity has a configuration error."
msgstr "由于此身份存在配置错误，当前结果按失败关闭处理。"

msgid "The current result will be calculated after applying the configuration."
msgstr "应用配置后将计算当前结果。"

msgid "The policy always applies to this identity."
msgstr "该策略始终对此身份生效。"

msgid "The policy applies because a weekly period matches now."
msgstr "当前匹配某个每周时段，因此该策略生效。"

msgid "The policy could not be fully applied."
msgstr "策略未能完全应用。"

msgid "The policy does not apply because no weekly period matches now."
msgstr "当前没有匹配的每周时段，因此该策略不生效。"

msgid "The policy never applies to this identity."
msgstr "该策略从不对此身份生效。"

msgid "The router clock is not valid, so temporary approval is unavailable."
msgstr "路由器时钟无效，因此临时授权不可用。"

msgid "The temporary approval operation failed."
msgstr "临时授权操作失败。"

msgid "These LAN clients were detected but are not recognized as an identity. They follow the global default and do not participate in scheduling."
msgstr "已检测到这些 LAN 客户端，但它们尚未被识别为身份。它们遵循全局默认结果，不参与时间调度。"

msgid "These runtime-only ALLOW overrides are separate from saved policies. They disappear at expiry and after a router reboot."
msgstr "这些仅运行时有效的“允许”覆盖与已保存策略相互独立。它们会在到期或路由器重启后消失。"

msgid "This MAC address is already recognized as another identity."
msgstr "此 MAC 地址已被识别为另一个身份。"

msgid "This detected MAC address will be recognized as the selected identity."
msgstr "检测到的此 MAC 地址将被识别为所选身份。"

msgid "This is runtime authorization, not a persistent rule or weekly schedule."
msgstr "这是运行时授权，不是持久规则或每周时间表。"

msgid "This reverses the result for both selected and unselected clients. Unknown clients follow the unselected result."
msgstr "这会同时反转已选和未选客户端的结果。未知客户端遵循未选结果。"

msgid "This stable identifier is independent of the display name and access rules."
msgstr "此稳定标识符与显示名称和访问规则相互独立。"

msgid "Thursday"
msgstr "星期四"

msgid "Tracked / accelerated flows"
msgstr "已跟踪 / 已加速流"

msgid "Tuesday"
msgstr "星期二"

msgid "Type"
msgstr "类型"

msgid "UDP destination ports"
msgstr "UDP 目标端口"

msgid "Unavailable"
msgstr "不可用"

msgid "Unclassified / load shed"
msgstr "未分类 / 已卸载"

msgid "Unclassified traffic"
msgstr "未分类流量"

msgid "Unknown"
msgstr "未知"

msgid "Unknown class"
msgstr "未知类别"

msgid "Unknown client"
msgstr "未知客户端"

msgid "Unknown detected clients have no subject or application schedule. This independent application-layer fallback applies to all of their traffic."
msgstr "检测到的未知客户端没有主体或应用时间表。此独立的应用层回退结果适用于它们的所有流量。"

msgid "Unknown identity"
msgstr "未知身份"

msgid "Unnamed"
msgstr "未命名"

msgid "Unnamed application class"
msgstr "未命名应用类别"

msgid "Unnamed identity"
msgstr "未命名身份"

msgid "Unsupported hardware flow offload is enabled."
msgstr "已启用不受支持的硬件流量卸载。"

msgid "View LAN observations, identities, bindings, and Internet access policy"
msgstr "查看 LAN 观测、身份、绑定和互联网访问策略"

msgid "Volatile approval state is not synchronized; new approvals must not be trusted until the service reports recovery."
msgstr "易失性授权状态尚未同步；在服务报告恢复之前，不应信任新授权。"

msgid "Wednesday"
msgstr "星期三"

msgid "Weekly schedule"
msgstr "每周时间表"

msgid "When access is blocked"
msgstr "访问被阻止时"
