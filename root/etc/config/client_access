config client_access 'main'
	option schema_version '4'
	option enabled '0'
	option mode 'blacklist'
	option app_filter_enabled '0'
	option unknown_subject_app_verdict 'allow'
	option provisional_app_verdict 'allow'
	option max_packets_inspected '1'
	option max_bytes_examined '256'
	option max_classification_age_ms '200'
	option max_pending_entries '256'
	option max_new_classifications_per_second '512'
	option per_subject_new_classification_rate '64'
	option signature_table_memory_limit '262144'
	option sfo_revocation_deadline_ms '2000'
	option deny_action 'reject'
	list source_zone 'lan'
	list destination_zone 'wan'
	option safety_interval '60'

# Identities are stable, user-managed objects. Their named UCI section is the
# identity ID. Bindings carry nftables selectors but never carry policy.
