#!/bin/sh /etc/rc.common

USE_PROCD=1
START=21
STOP=89

PROG=/usr/sbin/client-accessd
BPFCTL=/usr/sbin/client-access-bpfctl

start_service() {
	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	[ ! -x "$BPFCTL" ] || "$BPFCTL" disable
}

reload_service() {
	ubus call client_access reconcile '{"reason":"service-reload"}' >/dev/null 2>&1 || restart
}

service_triggers() {
	procd_add_reload_trigger client_access firewall network
}
