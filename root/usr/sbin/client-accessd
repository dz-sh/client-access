'use strict';

import { cursor } from 'uci';
import { popen, stat } from 'fs';
import * as ubus from 'ubus';
import * as uloop from 'uloop';
import * as policy from 'client_access.policy';
import * as app_policy from 'client_access.app_policy';
import * as classification from 'client_access.classification';
import * as model from 'client_access.model';
import * as runtime_policy from 'client_access.runtime';

const NFT = '/usr/sbin/nft';
const FW4 = '/sbin/fw4';
const BPFCTL = '/usr/sbin/client-access-bpfctl';

let timer, published, conn;
let generation = 0;
let applied_signature = null;
let app_policy_generation = 0;
let classifier_generation = 0;
let app_applied_signature = null;
let classifier_applied_signature = null;
let app_applied_sources = [];
let app_applied_destinations = [];
let generation_floors_loaded = false;
let app_attached_interfaces = [];
let dns_subscriber, observation_flush_timer;
let dns_subscribed = false;
let observation_store = {};
let observation_generation = 1;
let observation_profile_signature = null;
let dns_window_epoch = 0;
let dns_window_events = 0;
let dns_events_accepted = 0;
let dns_events_dropped = 0;
let classification_conflicts = 0;
let projection_publish_errors = 0;
let observations_expired = 0;
let observations_stale = 0;
let last_app_compiled = null;
let state = {
	running: true,
	applied: false,
	generation: 0,
	last_reason: 'startup',
	last_attempt: null,
	last_success: null,
	last_error: null,
	next_transition: null,
	clock_valid: false,
	mode: null,
	default_verdict: null,
	exception_verdict: null,
	identity_count: 0,
	active_identity_count: 0,
	binding_count: 0,
	exception_count: 0,
	source_interfaces: [],
	destination_interfaces: [],
	errors: [],
	warnings: [],
	app_filter: {
		backend_mode: 'V3_NFT_ONLY',
		requested_enabled: false,
		enabled: false,
		available: false,
		degraded: false,
		retained_previous_snapshot: false,
		app_policy_generation: 0,
		classifier_generation: 0,
		dns_subscribed: false,
		dns_events_accepted: 0,
		dns_events_dropped: 0,
		classification_conflicts: 0,
		projection_publish_errors: 0,
		next_transition: null,
		errors: [],
		warnings: [],
	},
};

function as_list(value) {
	if (value == null)
		return [];
	return type(value) == 'array' ? value : [ value ];
}

function read_config() {
	const uci = cursor();
	let config = {
		schema_version: uci.get('client_access', 'main', 'schema_version'),
		enabled: uci.get('client_access', 'main', 'enabled'),
		mode: uci.get('client_access', 'main', 'mode'),
		app_filter_enabled: uci.get('client_access', 'main', 'app_filter_enabled'),
		unknown_subject_app_verdict: uci.get('client_access', 'main', 'unknown_subject_app_verdict'),
		provisional_app_verdict: uci.get('client_access', 'main', 'provisional_app_verdict'),
		max_packets_inspected: uci.get('client_access', 'main', 'max_packets_inspected'),
		max_bytes_examined: uci.get('client_access', 'main', 'max_bytes_examined'),
		max_classification_age_ms: uci.get('client_access', 'main', 'max_classification_age_ms'),
		max_pending_entries: uci.get('client_access', 'main', 'max_pending_entries'),
		max_new_classifications_per_second: uci.get('client_access', 'main', 'max_new_classifications_per_second'),
		per_subject_new_classification_rate: uci.get('client_access', 'main', 'per_subject_new_classification_rate'),
		signature_table_memory_limit: uci.get('client_access', 'main', 'signature_table_memory_limit'),
		deny_action: uci.get('client_access', 'main', 'deny_action'),
		source_zone: as_list(uci.get('client_access', 'main', 'source_zone')),
		destination_zone: as_list(uci.get('client_access', 'main', 'destination_zone')),
		safety_interval: uci.get('client_access', 'main', 'safety_interval') ?? 60,
		identities: [],
		bindings: [],
		app_classes: [],
		app_rules: [],
		flow_offloading: false,
		flow_offloading_hw: false,
	};

	uci.foreach('client_access', 'identity', function(s) {
		push(config.identities, {
			id: s['.name'],
			section: s['.name'],
			name: s.name ?? s['.name'],
			subject_id: s.subject_id,
			activation: s.activation,
			schedule: s.schedule,
		});
	});
	uci.foreach('client_access', 'app_class', function(s) {
		push(config.app_classes, {
			section: s['.name'],
			profile_id: s['.name'],
			profile_schema_version: s.profile_schema_version,
			profile_source: s.profile_source,
			profile_license: s.profile_license,
			profile_provenance: s.profile_provenance,
			id: s.class_id,
			name: s.name ?? s['.name'],
			kind: s.kind,
			parent_id: s.parent_id,
			domains: as_list(s.domain),
			tcp_ports: as_list(s.tcp_port),
			udp_ports: as_list(s.udp_port),
			ipv4_prefixes: as_list(s.ipv4_prefix),
			ipv6_prefixes: as_list(s.ipv6_prefix),
		});
	});
	uci.foreach('client_access', 'app_rule', function(s) {
		push(config.app_rules, {
			section: s['.name'],
			identity: s.identity,
			class_id: s.class_id,
			verdict: s.verdict,
			activation: s.activation,
			schedule: s.schedule,
		});
	});
	uci.foreach('client_access', 'binding', function(s) {
		push(config.bindings, {
			section: s['.name'],
			identity: s.identity,
			type: s.type,
			value: s.value,
		});
	});
	uci.foreach('firewall', 'defaults', function(s) {
		config.flow_offloading = s.flow_offloading == '1';
		config.flow_offloading_hw = s.flow_offloading_hw == '1';
		return false;
	});
	uci.unload();
	return config;
}

function run_capture(argv) {
	const proc = popen(argv, 'r');
	if (!proc)
		return { code: null, output: '' };
	const output = proc.read('all') ?? '';
	return { code: proc.close(), output };
}

function run_write(argv, content) {
	const proc = popen(argv, 'w');
	if (!proc)
		return { ok: false, error: `Unable to start ${argv[0]}` };
	if (proc.write(content) != length(content)) {
		proc.close();
		return { ok: false, error: `Unable to write complete input to ${argv[0]}` };
	}
	const code = proc.close();
	return code == 0
		? { ok: true, error: null }
		: { ok: false, error: `${argv[0]} exited with code ${code}` };
}

function unique_strings(values) {
	let result = [], seen = {};
	for (let value in values) {
		value = trim('' + value);
		if (length(value) && !seen[value]) {
			seen[value] = true;
			push(result, value);
		}
	}
	sort(result);
	return result;
}

function resolve_zones(zones) {
	let interfaces = [], errors = [];
	for (let zone in zones) {
		zone = trim('' + zone);
		if (!length(zone))
			continue;

		const result = run_capture([ FW4, 'zone', zone ]);
		if (result.code != 0) {
			push(errors, `Unable to resolve firewall zone '${zone}'`);
			continue;
		}

		for (let ifname in split(trim(result.output), /\s+/))
			if (length(ifname))
				push(interfaces, ifname);
	}
	return { interfaces: unique_strings(interfaces), errors };
}

function nft_quote(value) {
	return '"' + replace(replace(value, /\\/g, '\\\\'), /"/g, '\\"') + '"';
}

function nft_elements(name, values, formatter) {
	let script = `flush set inet fw4 ${name}\n`;
	if (length(values))
		script += `add element inet fw4 ${name} { ${join(', ', map(values, formatter))} }\n`;
	return script;
}

function desired_signature(compiled, projection, sources, destinations) {
	if (!compiled.enabled)
		return sprintf('%J', { enabled: false });
	return sprintf('%J', {
		enabled: true,
		mode: compiled.mode,
		deny_action: compiled.deny_action,
		exceptions: projection.exceptions,
		sources,
		destinations,
	});
}

function app_signature(app_compiled, subject_projection, sources, destinations) {
	return sprintf('%J', {
		enabled: app_compiled.enabled,
		unknown_subject_app_verdict: app_compiled.unknown_subject_app_verdict,
		provisional_app_verdict: app_compiled.provisional_app_verdict,
		selectors: subject_projection.selectors,
		policies: app_compiled.policies,
		resource_limits: app_compiled.resource_limits,
		sources,
		destinations,
	});
}

function classifier_signature(runtime_projection) {
	return runtime_projection.signature;
}

function load_generation_floors() {
	if (generation_floors_loaded)
		return;
	const result = run_capture([ BPFCTL, 'generations' ]);
	const values = split(trim(result.output), /\s+/);
	if (result.code != 0 || length(values) != 2 ||
	    !match(values[0], /^(0|[1-9][0-9]*)$/) ||
	    !match(values[1], /^(0|[1-9][0-9]*)$/))
		return;
	const policy_floor = +values[0];
	const classifier_floor = +values[1];
	if (policy_floor > app_policy_generation)
		app_policy_generation = policy_floor;
	if (classifier_floor > classifier_generation)
		classifier_generation = classifier_floor;
	generation_floors_loaded = true;
}

function verdict_number(verdict) {
	return verdict == 'deny' ? 1 : 0;
}

function app_snapshot(app_compiled, runtime_projection, subject_projection,
		candidate_generation, candidate_classifier_generation) {
	const limits = app_compiled.resource_limits;
	let lines = [ sprintf('CONFIG %d %d %d %d %d %d %d %d %d %d %d',
		app_compiled.enabled ? 1 : 0,
		candidate_generation,
		candidate_classifier_generation,
		verdict_number(app_compiled.unknown_subject_app_verdict),
		verdict_number(app_compiled.provisional_app_verdict),
		limits.max_packets_inspected,
		limits.max_bytes_examined,
		limits.max_classification_age_ms,
		limits.max_pending_entries,
		limits.max_new_classifications_per_second,
		limits.per_subject_new_classification_rate) ];
	for (let selector in subject_projection.selectors)
		push(lines, sprintf('SUBJECT %s %d', selector.mac, selector.subject_id));
	for (let entry in app_compiled.policies)
		push(lines, sprintf('POLICY %d %d %d',
			entry.subject_id, entry.class_id, verdict_number(entry.verdict)));
	for (let entry in runtime_projection.ports)
		push(lines, sprintf('PORT %d %d %d %d %d', entry.protocol, entry.port,
			entry.hint.class_id, entry.hint.category_id, entry.hint.kind));
	for (let entry in runtime_projection.ipv4_prefixes)
		push(lines, sprintf('PREFIX4 %s %d %d %d', entry.prefix,
			entry.hint.class_id, entry.hint.category_id, entry.hint.kind));
	for (let entry in runtime_projection.ipv6_prefixes)
		push(lines, sprintf('PREFIX6 %s %d %d %d', entry.prefix,
			entry.hint.class_id, entry.hint.category_id, entry.hint.kind));
	return join('\n', lines) + '\n';
}

function observation_store_size() {
	let count = 0;
	for (let key in observation_store)
		count++;
	return count;
}

function observation_values() {
	let names = keys(observation_store), result = [];
	sort(names);
	for (let name in names)
		push(result, observation_store[name]);
	return result;
}

function prepare_observations(profile_signature) {
	const profile_changed = observation_profile_signature == null ||
		observation_profile_signature != profile_signature;
	return {
		generation: observation_profile_signature != null && profile_changed
			? observation_generation + 1 : observation_generation,
		observations: profile_changed ? [] : observation_values(),
		profile_signature,
		profile_changed,
	};
}

function commit_observations(context, epoch) {
	if (context.profile_changed) {
		observations_stale += observation_store_size();
		observation_store = {};
		observation_generation = context.generation;
		observation_profile_signature = context.profile_signature;
	}
	for (let id, observation in observation_store) {
		if (observation.generation != observation_generation) {
			delete observation_store[id];
			observations_stale++;
		}
		else if (observation.expires_at <= epoch) {
			delete observation_store[id];
			observations_expired++;
		}
	}
}

function flush_observation_updates() {
	if (!last_app_compiled || !last_app_compiled.requested_enabled)
		return;
	const result = reconcile('classification-observation', false);
	if (!result.app_filter.applied)
		projection_publish_errors++;
}

function queue_dns_result(data) {
	if (!last_app_compiled || !last_app_compiled.enabled ||
	    observation_profile_signature == null)
		return;

	const epoch = clock()[0];
	if (epoch != dns_window_epoch) {
		dns_window_epoch = epoch;
		dns_window_events = 0;
	}
	if (dns_window_events >= 128) {
		dns_events_dropped++;
		return;
	}
	dns_window_events++;

	const normalized = classification.normalize_dns_observation(data,
		observation_generation, epoch);
	if (!normalized.valid) {
		dns_events_dropped++;
		return;
	}
	const observation = normalized.observation;
	if (!observation_store[observation.id] && observation_store_size() >= 256) {
		dns_events_dropped++;
		return;
	}
	observation_store[observation.id] = observation;
	dns_events_accepted++;

	if (!observation_flush_timer)
		observation_flush_timer = uloop.timer(100,
			function() { flush_observation_updates(); });
	else
		observation_flush_timer.set(100);
}

function ensure_dns_subscription() {
	if (!dns_subscriber) {
		dns_subscriber = conn.subscriber(
			function(notify) {
				queue_dns_result(notify.data ?? {});
				notify.reply({}, 0);
			},
			function(id) {
				dns_subscribed = false;
			}
		);
	}
	if (!dns_subscribed)
		dns_subscribed = !!dns_subscriber.subscribe('dnsmasq.dns');
}

function prune_app_interfaces(keep) {
	if (!stat(BPFCTL)) {
		app_attached_interfaces = [];
		return { code: null, output: '' };
	}
	const result = run_capture([ BPFCTL, 'prune', ...keep ]);
	if (result.code == 0)
		app_attached_interfaces = [ ...keep ];
	return result;
}

function apply_app_nft_scope(enabled, sources, destinations) {
	if (!enabled) {
		sources = [];
		destinations = [];
	}

	let script = '';
	script += nft_elements('client_access_app_sources', sources, nft_quote);
	script += nft_elements('client_access_app_destinations', destinations, nft_quote);
	const proc = popen([ NFT, '-f', '-' ], 'w');
	if (!proc)
		return { ok: false, error: 'Unable to start nft for application-filter scope' };
	if (proc.write(script) != length(script)) {
		proc.close();
		return { ok: false, error: 'Unable to write complete application-filter scope transaction' };
	}
	const code = proc.close();
	return code == 0
		? { ok: true, error: null }
		: { ok: false, error: `Application-filter nft scope failed with exit code ${code}` };
}

function neutralize_app_runtime(errors) {
	const disabled = stat(BPFCTL)
		? run_capture([ BPFCTL, 'disable' ])
		: { code: null, output: '' };
	if (disabled.code != null && disabled.code != 0)
		push(errors, 'Unable to disable application BPF state');
	const pruned = prune_app_interfaces([]);
	if (pruned.code != null && pruned.code != 0)
		push(errors, 'Unable to detach all owned application BPF filters');
	const scope = apply_app_nft_scope(false, [], []);
	if (!scope.ok)
		push(errors, scope.error);
	app_applied_signature = null;
	classifier_applied_signature = null;
	app_applied_sources = [];
	app_applied_destinations = [];
	return {
		ok: (disabled.code == null || disabled.code == 0) &&
			(pruned.code == null || pruned.code == 0) && scope.ok,
		backend_present: disabled.code != null,
	};
}

function restore_app_scope(errors) {
	const scope = apply_app_nft_scope(true, app_applied_sources,
		app_applied_destinations);
	if (scope.ok)
		return true;
	push(errors, scope.error);
	neutralize_app_runtime(errors);
	return false;
}

function runtime_flow_offload() {
	const result = run_capture([ NFT, 'list', 'ruleset' ]);
	return {
		checked: result.code == 0,
		ruleset: result.output,
	};
}

function apply_app_filter(config, app_compiled, classification_state,
		subject_projection, sources, destinations, zone_errors, force) {
	let errors = [ ...app_compiled.errors, ...classification_state.errors,
		...subject_projection.errors, ...zone_errors ];
	let warnings = [ ...app_compiled.warnings, ...classification_state.warnings ];
	const runtime_projection = classification_state.runtime_projection;
	const previously_enabled = app_applied_signature != null && length(app_attached_interfaces) > 0;
	const previous_interfaces = {};
	for (let ifname in app_attached_interfaces)
		previous_interfaces[ifname] = true;

	if (!app_compiled.requested_enabled) {
		observation_store = {};
		const neutral = neutralize_app_runtime(errors);
		return {
			ok: neutral.ok,
			available: false,
			enabled: false,
			degraded: !neutral.ok,
			retained_previous_snapshot: false,
			backend_mode: 'V3_NFT_ONLY',
			generation: app_policy_generation,
			classifier_generation,
			errors,
			warnings,
		};
	}
	if (!stat(BPFCTL)) {
		push(errors, 'The optional TC eBPF application backend is not installed');
		neutralize_app_runtime(errors);
		return {
			ok: false,
			available: false,
			enabled: false,
			degraded: true,
			retained_previous_snapshot: false,
			backend_mode: 'V3_NFT_ONLY',
			generation: app_policy_generation,
			classifier_generation,
			errors,
			warnings,
		};
	}
	const runtime_offload = runtime_flow_offload();
	const offload_refusal = runtime_policy.offload_refusal(config,
		runtime_offload.checked, runtime_offload.ruleset);
	if (offload_refusal) {
		push(errors, offload_refusal == 'unverifiable_ruleset'
			? 'Unable to verify that the active nftables ruleset has no flow offload path'
			: 'Disable firewall and custom nftables flow offloading before enabling application filtering');
		const neutral = neutralize_app_runtime(errors);
		return {
			ok: false,
			available: neutral.backend_present,
			enabled: false,
			degraded: true,
			retained_previous_snapshot: false,
			backend_mode: 'V3_NFT_ONLY',
			generation: app_policy_generation,
			classifier_generation,
			errors,
			warnings,
		};
	}
	if (!length(sources))
		push(errors, 'No LAN source interfaces resolved for the application filter');
	if (!length(destinations))
		push(errors, 'No Internet destination interfaces resolved for the application filter');
	if (!app_compiled.enabled || length(errors)) {
		if (!previously_enabled) {
			neutralize_app_runtime(errors);
			return {
				ok: false,
				available: false,
				enabled: false,
				degraded: true,
				retained_previous_snapshot: false,
				backend_mode: 'V3_NFT_ONLY',
				generation: app_policy_generation,
				classifier_generation,
				errors,
				warnings,
			};
		}
		const retained = restore_app_scope(errors);
		return {
			ok: false,
			available: retained,
			enabled: retained,
			degraded: true,
			retained_previous_snapshot: retained,
			backend_mode: retained ? 'V4_BPF_BASIC' : 'V3_NFT_ONLY',
			generation: app_policy_generation,
			classifier_generation,
			errors,
			warnings,
		};
	}

	const ensured = run_capture([ BPFCTL, 'ensure' ]);
	if (ensured.code != 0) {
		push(errors, 'Unable to load or verify the TC eBPF application backend');
		neutralize_app_runtime(errors);
		return {
			ok: false,
			available: false,
			enabled: false,
			degraded: true,
			retained_previous_snapshot: false,
			backend_mode: 'V3_NFT_ONLY',
			generation: app_policy_generation,
			classifier_generation,
			errors,
			warnings,
		};
	}
	load_generation_floors();

	let attached = [];
	for (let ifname in sources) {
		const result = run_capture([ BPFCTL, 'attach', ifname ]);
		if (result.code != 0)
			push(errors, `Unable to attach application filter to '${ifname}'`);
		else
			push(attached, ifname);
	}
	if (length(errors)) {
		for (let ifname in attached)
			if (!previous_interfaces[ifname])
				run_capture([ BPFCTL, 'detach', ifname ]);
		const retained = previously_enabled && restore_app_scope(errors);
		return {
			ok: false,
			available: true,
			enabled: retained,
			degraded: true,
			retained_previous_snapshot: retained,
			backend_mode: retained ? 'V4_BPF_BASIC' : 'V3_NFT_ONLY',
			generation: app_policy_generation,
			classifier_generation,
			errors,
			warnings,
		};
	}

	const signature = app_signature(app_compiled, subject_projection, sources, destinations);
	const changed = signature != app_applied_signature;
	const candidate_generation = changed ? app_policy_generation + 1 : app_policy_generation;
	const current_classifier_signature = classifier_signature(runtime_projection);
	const classifier_changed = current_classifier_signature != classifier_applied_signature;
	const candidate_classifier_generation = classifier_changed
		? classifier_generation + 1 : classifier_generation;
	if (force || changed || classifier_changed) {
		const result = run_write([ BPFCTL, 'sync' ],
			app_snapshot(app_compiled, runtime_projection, subject_projection,
				candidate_generation, candidate_classifier_generation));
		if (!result.ok) {
			push(errors, result.error);
			for (let ifname in attached)
				if (!previous_interfaces[ifname])
					run_capture([ BPFCTL, 'detach', ifname ]);
			const retained = previously_enabled && restore_app_scope(errors);
			return {
				ok: false,
				available: true,
				enabled: retained,
				degraded: true,
				retained_previous_snapshot: retained,
				backend_mode: retained ? 'V4_BPF_BASIC' : 'V3_NFT_ONLY',
				generation: app_policy_generation,
				classifier_generation,
				errors,
				warnings,
			};
		}
		if (changed)
			app_policy_generation = candidate_generation;
		if (classifier_changed)
			classifier_generation = candidate_classifier_generation;
	}
	const scope = apply_app_nft_scope(true, sources, destinations);
	if (!scope.ok) {
		push(errors, scope.error);
		neutralize_app_runtime(errors);
		return {
			ok: false,
			available: true,
			enabled: false,
			degraded: true,
			retained_previous_snapshot: false,
			backend_mode: 'V3_NFT_ONLY',
			generation: app_policy_generation,
			classifier_generation,
			errors,
			warnings,
		};
	}
	const pruned = prune_app_interfaces(sources);
	if (pruned.code != 0) {
		push(errors, 'Unable to establish the exact application-filter TC interface set');
		neutralize_app_runtime(errors);
		return {
			ok: false,
			available: true,
			enabled: false,
			degraded: true,
			retained_previous_snapshot: false,
			backend_mode: 'V3_NFT_ONLY',
			generation: app_policy_generation,
			classifier_generation,
			errors,
			warnings,
		};
	}
	app_attached_interfaces = [ ...sources ];
	app_applied_sources = [ ...sources ];
	app_applied_destinations = [ ...destinations ];
	if (classifier_changed) {
		classifier_applied_signature = current_classifier_signature;
	}
	app_applied_signature = signature;
	return {
		ok: true,
		available: true,
		enabled: true,
		degraded: false,
		retained_previous_snapshot: false,
		backend_mode: 'V4_BPF_BASIC',
		generation: app_policy_generation,
		classifier_generation,
		errors,
		warnings,
	};
}

function app_runtime_snapshot(enabled, policy_generation,
		classifier_generation, interfaces) {
	if (!enabled || !stat(BPFCTL))
		return { available: false, status_json: null, error: null };

	const gc = run_capture([ BPFCTL, 'gc', '300' ]);
	const health = run_capture([ BPFCTL, 'health', '' + policy_generation,
		'' + classifier_generation, ...interfaces ]);
	return {
		available: health.code == 0,
		status_json: health.code == 0 ? trim(health.output) : null,
		error: health.code != 0
			? 'Application-filter generations or TC attachments do not match the published snapshot'
			: (gc.code == 0 ? null : 'Unable to reclaim idle application flows'),
	};
}

function current_status() {
	let result = { ...state, app_filter: { ...(state.app_filter ?? {}) } };
	result.app_filter.dns_subscribed = dns_subscribed;
	result.app_filter.observation_entries = observation_store_size();
	result.app_filter.dns_events_accepted = dns_events_accepted;
	result.app_filter.dns_events_dropped = dns_events_dropped;
	result.app_filter.classification_conflicts = classification_conflicts;
	result.app_filter.projection_publish_errors = projection_publish_errors;
	if (result.app_filter.enabled && stat(BPFCTL)) {
		const runtime = run_capture([ BPFCTL, 'health',
			'' + result.app_filter.app_policy_generation,
			'' + result.app_filter.classifier_generation,
			...app_attached_interfaces ]);
		result.app_filter.runtime_available = runtime.code == 0;
		result.app_filter.runtime_status_json = runtime.code == 0
			? trim(runtime.output) : null;
		if (runtime.code != 0) {
			let errors = [ ...(result.app_filter.errors ?? []),
				'Application-filter runtime health no longer matches the published snapshot' ];
			neutralize_app_runtime(errors);
			result.app_filter = {
				...result.app_filter,
				backend_mode: 'V3_NFT_ONLY',
				enabled: false,
				available: false,
				applied: false,
				degraded: true,
				retained_previous_snapshot: false,
				runtime_available: false,
				runtime_status_json: null,
				errors,
			};
			state = result;
		}
	}
	return result;
}

function apply_nft(compiled, projection, sources, destinations) {
	let exceptions = projection.exceptions;
	if (!compiled.enabled) {
		exceptions = [];
		sources = [];
		destinations = [];
	}

	let script = '';
	script += nft_elements('client_access_exceptions', exceptions, value => value);
	script += nft_elements('client_access_sources', sources, nft_quote);
	script += nft_elements('client_access_destinations', destinations, nft_quote);
	script += nft_elements('client_access_whitelist_mode',
		compiled.enabled && compiled.mode == 'whitelist' ? [ 'ipv4', 'ipv6' ] : [], value => value);
	script += nft_elements('client_access_drop_mode',
		compiled.enabled && compiled.deny_action == 'drop' ? [ 'ipv4', 'ipv6' ] : [], value => value);

	const proc = popen([ NFT, '-f', '-' ], 'w');
	if (!proc)
		return { ok: false, error: 'Unable to start nft' };
	if (proc.write(script) != length(script)) {
		proc.close();
		return { ok: false, error: 'Unable to write complete nft transaction' };
	}

	const code = proc.close();
	return code == 0
		? { ok: true, error: null }
		: { ok: false, error: `nft transaction failed with exit code ${code}` };
}

function update_timer(config, compiled, app_compiled, classification_state, epoch) {
	let delay = policy.safety_delay_ms(compiled, epoch, config.safety_interval);
	if (app_compiled.requested_enabled && app_compiled.next_transition != null) {
		const app_delay = (app_compiled.next_transition - epoch) * 1000;
		if (app_delay > 0 && app_delay < delay)
			delay = app_delay;
	}
	if (app_compiled.requested_enabled && classification_state.next_expiry != null) {
		const expiry_delay = (classification_state.next_expiry - epoch) * 1000;
		if (expiry_delay > 0 && expiry_delay < delay)
			delay = expiry_delay;
	}
	timer.set(delay);
}

function count_active(identities) {
	let count = 0;
	for (let identity in identities)
		if (identity.effective_active)
			count++;
	return count;
}

function compile_runtime(config, epoch) {
	const compiled = policy.compile(config, epoch);
	const projection = model.project(compiled, config.bindings);
	const app_compiled = app_policy.compile(config, epoch);
	const observation_context = prepare_observations(
		app_compiled.classification_model.signature);
	const classification_state = classification.resolve(
		app_compiled.classification_model,
		observation_context.observations,
		epoch,
		observation_context.generation,
		app_compiled.resource_limits);
	const subject_projection = model.project_subjects(app_compiled, config.bindings);
	const consistency = app_policy.consistency(compiled, app_compiled);
	return { compiled, projection, app_compiled, classification_state,
		observation_context, subject_projection, consistency };
}

function reconcile(reason, force) {
	ensure_dns_subscription();
	const epoch = clock()[0];
	const config = read_config();
	const runtime = compile_runtime(config, epoch);
	const compiled = runtime.compiled;
	const projection = runtime.projection;
	const app_compiled = runtime.app_compiled;
	const classification_state = runtime.classification_state;
	const subject_projection = runtime.subject_projection;
	const source = compiled.enabled || app_compiled.requested_enabled
		? resolve_zones(config.source_zone)
		: { interfaces: [], errors: [] };
	const destination = compiled.enabled || app_compiled.requested_enabled
		? resolve_zones(config.destination_zone)
		: { interfaces: [], errors: [] };
	const signature = desired_signature(compiled, projection, source.interfaces, destination.interfaces);
	let readiness_errors = compiled.enabled
		? [ ...source.errors, ...destination.errors ] : [];
	if (compiled.enabled && !length(source.interfaces))
		push(readiness_errors, 'No source interfaces resolved; enforcement is inactive');
	if (compiled.enabled && !length(destination.interfaces))
		push(readiness_errors, 'No destination interfaces resolved; enforcement is inactive');
	let errors = [ ...compiled.errors, ...projection.errors, ...readiness_errors ];
	let warnings = [ ...compiled.warnings, ...projection.warnings ];
	let apply = { ok: true, error: null };

	if (force || signature != applied_signature)
		apply = apply_nft(compiled, projection, source.interfaces, destination.interfaces);
	if (apply.ok) {
		if (force || signature != applied_signature)
			generation++;
		applied_signature = signature;
	}
	else
		push(errors, apply.error);

	let app_apply = apply_app_filter(config, app_compiled, classification_state,
		subject_projection, source.interfaces, destination.interfaces,
		[ ...source.errors, ...destination.errors ], force);
	let app_runtime = app_runtime_snapshot(app_apply.enabled,
		app_apply.generation, app_apply.classifier_generation,
		app_attached_interfaces);
	if (app_apply.enabled && !app_runtime.available) {
		push(app_apply.errors, app_runtime.error ??
			'Application-filter runtime state became unavailable');
		neutralize_app_runtime(app_apply.errors);
		app_apply = {
			...app_apply,
			ok: false,
			available: false,
			enabled: false,
			degraded: true,
			retained_previous_snapshot: false,
			backend_mode: 'V3_NFT_ONLY',
		};
	}
	else if (app_runtime.error)
		push(app_apply.warnings, app_runtime.error);
	for (let warning in runtime.consistency.warnings)
		push(app_apply.warnings, warning);
	if (app_apply.ok && app_apply.enabled)
		commit_observations(runtime.observation_context, epoch);

	const configuration_ready = compiled.schema_supported && compiled.mode_valid;
	const synchronized = apply.ok && configuration_ready && !length(readiness_errors);
	const state_error = apply.error ??
		(length(readiness_errors) ? join('; ', readiness_errors) :
		 (!configuration_ready ? join('; ', compiled.errors) : null));

	last_app_compiled = app_compiled;
	classification_conflicts = classification_state.semantic_state.conflict_count;
	state = {
		running: true,
		applied: synchronized,
		enabled: compiled.enabled,
		requested_enabled: compiled.requested_enabled,
		schema_supported: compiled.schema_supported,
		generation,
		last_reason: reason ?? 'unknown',
		last_attempt: epoch,
		last_success: synchronized ? epoch : state.last_success,
		last_error: state_error,
		next_transition: compiled.next_transition,
		clock_valid: compiled.clock_valid,
		mode: compiled.mode,
		deny_action: compiled.deny_action,
		default_verdict: compiled.default_verdict,
		exception_verdict: compiled.exception_verdict,
		identity_count: length(compiled.identities),
		active_identity_count: count_active(compiled.identities),
		binding_count: projection.binding_count,
		exception_count: compiled.enabled ? length(projection.exceptions) : 0,
		source_interfaces: source.interfaces,
		destination_interfaces: destination.interfaces,
		errors,
		warnings,
		app_filter: {
			backend_mode: app_apply.backend_mode,
			requested_enabled: app_compiled.requested_enabled,
			enabled: app_apply.enabled,
			degraded: app_apply.degraded,
			retained_previous_snapshot: app_apply.retained_previous_snapshot,
			available: app_apply.available,
			applied: app_apply.ok,
			app_policy_generation: app_apply.generation,
			classifier_generation: app_apply.classifier_generation,
			classifier_signature_count: classification_state.runtime_projection.signature_count,
			classifier_signature_memory_bytes: classification_state.runtime_projection.signature_memory_bytes,
			profile_count: app_compiled.classification_model.profile_count,
			classification_ir_entry_count: app_compiled.classification_model.ir_entry_count,
			semantic_entry_count: length(classification_state.semantic_state.entries),
			runtime_projection_entry_count: classification_state.runtime_projection.signature_count,
			provider_count: length(classification_state.semantic_state.provider_ids),
			resource_limits: app_compiled.resource_limits,
			runtime_available: app_runtime.available,
			runtime_status_json: app_runtime.status_json,
			dns_subscribed,
			observation_entries: observation_store_size(),
			observation_generation,
			observations_expired,
			observations_stale,
			dns_events_accepted,
			dns_events_dropped,
			classification_conflicts,
			projection_publish_errors,
			next_transition: app_compiled.next_transition,
			subject_count: length(app_compiled.identities),
			selector_count: length(subject_projection.preview_selectors),
			policy_entry_count: length(app_compiled.policies),
			errors: app_apply.errors,
			warnings: app_apply.warnings,
		},
	};

	update_timer(config, compiled, app_compiled, classification_state, epoch);
	return state;
}

function observation_snapshot(config) {
	const query = ubus.connect();
	if (!query)
		return { observations: [], error: 'Unable to query LuCI host hints' };
	const hints = query.call('luci-rpc', 'getHostHints', {}) ?? {};
	query.disconnect();

	let owners = {};
	for (let binding in config.bindings) {
		const mac = binding.type == 'mac' ? model.normalize_mac(binding.value) : null;
		if (!mac)
			continue;
		owners[mac] ??= [];
		push(owners[mac], binding.identity);
	}

	let observations = [];
	for (let raw_mac, hint in hints) {
		const mac = model.normalize_mac(raw_mac);
		if (!mac)
			continue;
		push(observations, {
			type: 'mac',
			value: mac,
			name: hint.name,
			ipaddrs: hint.ipaddrs ?? [],
			ip6addrs: hint.ip6addrs ?? [],
			bound: !!length(owners[mac] ?? []),
			identity_ids: unique_strings(owners[mac] ?? []),
		});
	}
	return { observations, error: null };
}

function identity_inventory() {
	const epoch = clock()[0];
	const config = read_config();
	const runtime = compile_runtime(config, epoch);
	const observed = observation_snapshot(config);
	let observation_by_mac = {}, binding_by_identity = {};
	for (let observation in observed.observations)
		observation_by_mac[observation.value] = observation;
	for (let binding in runtime.projection.bindings) {
		const observation = observation_by_mac[binding.value];
		binding_by_identity[binding.identity_id] ??= [];
		push(binding_by_identity[binding.identity_id], {
			section: binding.section,
			type: binding.type,
			value: binding.value,
			valid: binding.valid,
			error: binding.error,
			observed: !!observation,
			observed_name: observation ? observation.name : null,
			ipaddrs: observation ? observation.ipaddrs : [],
			ip6addrs: observation ? observation.ip6addrs : [],
		});
	}

	let identities = [];
	for (let identity in runtime.compiled.identities) {
		push(identities, {
			id: identity.id,
			name: identity.name,
			activation: identity.activation,
			verdict: identity.verdict,
			effective_active: identity.effective_active,
			reason: identity.reason,
			schedule_active: identity.schedule_active,
			next_transition: identity.next_transition,
			bindings: binding_by_identity[identity.id] ?? [],
		});
	}
	return {
		identities,
		mode: runtime.compiled.mode,
		default_verdict: runtime.compiled.default_verdict,
		exception_verdict: runtime.compiled.exception_verdict,
		clock: epoch,
		errors: [ ...runtime.compiled.errors, ...runtime.projection.errors ],
		error: observed.error,
	};
}

function observation_inventory() {
	const config = read_config();
	const observed = observation_snapshot(config);
	return { observations: observed.observations, clock: clock()[0], error: observed.error };
}

uloop.init();
conn = ubus.connect();
if (!conn) {
	warn('client-accessd: unable to connect to ubus\n');
	exit(1);
}

published = conn.publish('client_access', {
	status: {
		call: function() { return current_status(); },
	},
	preview: {
		call: function() {
			const epoch = clock()[0];
			const config = read_config();
			const runtime = compile_runtime(config, epoch);
			return {
				compiled: runtime.compiled,
				projection: runtime.projection,
				app_compiled: runtime.app_compiled,
				classification_state: runtime.classification_state,
				subject_projection: runtime.subject_projection,
				consistency: runtime.consistency,
				clock: epoch,
			};
		},
	},
	identities: {
		call: function() { return identity_inventory(); },
	},
	observations: {
		call: function() { return observation_inventory(); },
	},
	reconcile: {
		args: { reason: 'string' },
		call: function(req, msg) { return reconcile(msg.reason ?? 'ubus', true); },
	},
});

if (!published) {
	warn('client-accessd: unable to publish ubus object\n');
	exit(1);
}

// Establish a known neutral cross-subsystem state before the first republish.
if (stat(BPFCTL))
	run_capture([ BPFCTL, 'disable' ]);
apply_app_nft_scope(false, [], []);

// The safety wakeup also repairs runtime set loss after an out-of-band fw4 reload.
timer = uloop.timer(1, function() { reconcile('timer', true); });
uloop.run();
