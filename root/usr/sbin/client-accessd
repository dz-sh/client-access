'use strict';

import * as ubus from 'ubus';
import * as uloop from 'uloop';
import * as policy from 'client_access.policy';
import * as app_policy from 'client_access.app_policy';
import * as classification from 'client_access.classification';
import * as model from 'client_access.model';
import * as temporary_approval from 'client_access.lease';
import * as config_adapter from 'client_access.config';
import * as lease_store from 'client_access.lease_store';
import * as firewall from 'client_access.firewall';
import * as bpf_runtime from 'client_access.bpf_runtime';
import * as observation_store from 'client_access.observation_store';
import * as reconciliation from 'client_access.reconcile';
import * as application_reconcile from 'client_access.application_reconcile';
import * as status_projection from 'client_access.status';
import * as runtime_policy from 'client_access.runtime';
import * as sfo_runtime from 'client_access.sfo_runtime';
import * as sfo_manager from 'client_access.sfo_manager';

const LEASE_JOURNAL = getenv('CA_LEASE_JOURNAL') ??
	'/tmp/client-access-approvals.json';

let timer, published, conn;
let generation = 0;
let applied_signature = null;
let app_runtime_state = application_reconcile.create();
let dns_subscriber, observation_flush_timer;
let dns_subscribed = false;
let observation_runtime = observation_store.create();
let classification_conflicts = 0;
let projection_publish_errors = 0;
let last_app_compiled = null;
let lease_database = temporary_approval.empty_database();
let lease_journal_loaded = false;
let lease_journal_dirty = false;
let lease_transaction_active = false;
let lease_journal_errors = [];
let effective_authorization_snapshot = null;
let latest_authorization_transitions = [];
let sfo_runtime_state = sfo_manager.create();
let state = {
	running: true,
	applied: false,
	generation: 0,
	last_reason: 'startup',
	last_attempt: null,
	last_success: null,
	last_error: null,
	next_transition: null,
	clock_valid: false,
	mode: null,
	default_verdict: null,
	exception_verdict: null,
	identity_count: 0,
	active_identity_count: 0,
	binding_count: 0,
	exception_count: 0,
	source_interfaces: [],
	destination_interfaces: [],
	errors: [],
	warnings: [],
	temporary_approvals: {
		active_count: 0,
		capacity: temporary_approval.constants.MAX_ACTIVE_LEASES,
		next_expiry: null,
		journal_available: true,
		latest_transitions: [],
		errors: [],
	},
	app_filter: {
		backend_mode: 'V3_NFT_ONLY',
		requested_enabled: false,
		enabled: false,
		available: false,
		degraded: false,
		retained_previous_snapshot: false,
		app_policy_generation: 0,
		classifier_generation: 0,
		dns_subscribed: false,
		dns_events_accepted: 0,
		dns_events_dropped: 0,
		classification_conflicts: 0,
		projection_publish_errors: 0,
		next_transition: null,
		errors: [],
		warnings: [],
	},
	software_offload: { ...sfo_runtime_state },
};

function lease_context(base_app_compiled) {
	return {
		identities: base_app_compiled.identities,
		classes: base_app_compiled.classes,
	};
}

function record_lease_errors(values) {
	for (let value in values) {
		if (length(lease_journal_errors) >= 16)
			break;
		let seen = false;
		for (let existing in lease_journal_errors)
			if (existing == value) {
				seen = true;
				break;
			}
		if (!seen)
			push(lease_journal_errors, value);
	}
}

function read_lease_journal(context, epoch, monotonic_now) {
	const parsed = lease_store.read(LEASE_JOURNAL, context, epoch, monotonic_now);
	lease_journal_errors = [];
	lease_database = parsed.database;
	record_lease_errors(parsed.errors);
	lease_journal_dirty = length(lease_journal_errors) > 0 ||
		!parsed.valid || parsed.expired_count > 0;
	lease_journal_loaded = true;
}

function refresh_lease_database(context, epoch, monotonic_now) {
	if (!lease_journal_loaded)
		read_lease_journal(context, epoch, monotonic_now);
	const before = sprintf('%J', lease_database);
	const parsed = temporary_approval.parse_database(lease_database, context,
		epoch, monotonic_now);
	lease_database = parsed.database;
	record_lease_errors(parsed.errors);
	if (before != sprintf('%J', lease_database) || parsed.expired_count > 0)
		lease_journal_dirty = true;
	return parsed;
}

function write_lease_journal(database) {
	const result = lease_store.write(LEASE_JOURNAL, database);
	if (result.ok)
		lease_journal_dirty = false;
	return result;
}

function unique_strings(values) {
	let result = [], seen = {};
	for (let value in values) {
		value = trim('' + value);
		if (length(value) && !seen[value]) {
			seen[value] = true;
			push(result, value);
		}
	}
	sort(result);
	return result;
}

function prepare_observations(profile_signature) {
	return observation_store.prepare(observation_runtime, profile_signature);
}

function commit_observations(context, epoch) {
	observation_store.commit(observation_runtime, context, epoch);
}

function flush_observation_updates() {
	if (!last_app_compiled || !last_app_compiled.requested_enabled)
		return;
	const result = reconcile('classification-observation', false);
	if (!result.app_filter.applied)
		projection_publish_errors++;
}

function queue_dns_result(data) {
	if (!last_app_compiled || !last_app_compiled.enabled ||
	    observation_runtime.profile_signature == null)
		return;

	const epoch = clock()[0];
	if (!observation_store.accept_dns(observation_runtime, data, epoch))
		return;

	if (!observation_flush_timer)
		observation_flush_timer = uloop.timer(100,
			function() { flush_observation_updates(); });
	else
		observation_flush_timer.set(100);
}

function ensure_dns_subscription() {
	if (!dns_subscriber) {
		dns_subscriber = conn.subscriber(
			function(notify) {
				queue_dns_result(notify.data ?? {});
				notify.reply({}, 0);
			},
			function(id) {
				dns_subscribed = false;
			}
		);
	}
	if (!dns_subscribed)
		dns_subscribed = !!dns_subscriber.subscribe('dnsmasq.dns');
}

function current_status() {
	let result = status_projection.snapshot(state, {
		dns_subscribed,
		observation_entries: observation_store.size(observation_runtime),
		dns_events_accepted: observation_runtime.accepted,
		dns_events_dropped: observation_runtime.dropped,
		classification_conflicts,
		projection_publish_errors,
	});
	if (result.app_filter.tracking_enabled && bpf_runtime.present()) {
		const runtime = bpf_runtime.health(
			result.app_filter.app_policy_generation,
			result.app_filter.classifier_generation,
			application_reconcile.interfaces(app_runtime_state));
		result.app_filter.runtime_available = runtime.code == 0;
		result.app_filter.runtime_status_json = runtime.code == 0
			? trim(runtime.output) : null;
		if (runtime.code == 0 && sfo_runtime_state.mode == 'SFO_ACTIVE') {
			let bpf_status = null;
			try { bpf_status = json(runtime.output); }
			catch (error) { bpf_status = null; }
			if (bpf_status == null || (bpf_status.flow_map_full ?? 0) > 0 ||
			    (bpf_status.flow_map_entries ?? 0) >=
				(bpf_status.flow_capacity ?? 0)) {
				sfo_runtime_state.mode = 'SFO_DEGRADED';
				sfo_runtime_state.correlation_health = 'DEGRADED';
				sfo_runtime_state.baseline_required = true;
				if (!length(sfo_runtime_state.errors))
					push(sfo_runtime_state.errors,
						'BPF semantic flow capacity is exhausted or cannot be verified');
				result.software_offload = { ...sfo_runtime_state };
				result.applied = false;
				state = result;
			}
		}
		if (runtime.code != 0) {
			if (sfo_runtime_state.mode == 'SFO_ACTIVE') {
				sfo_runtime_state.mode = 'SFO_DEGRADED';
				sfo_runtime_state.correlation_health = 'DEGRADED';
				sfo_runtime_state.baseline_required = true;
				push(sfo_runtime_state.errors,
					'BPF semantic flow correlation became unavailable');
				result.software_offload = { ...sfo_runtime_state };
				result.applied = false;
			}
			let errors = [ ...(result.app_filter.errors ?? []),
				'Application-filter runtime health no longer matches the published snapshot' ];
			application_reconcile.neutralize(app_runtime_state, errors);
			result = status_projection.application_degraded(result, errors);
			state = result;
		}
	}
	return result;
}

function update_timer(config, compiled, app_compiled, classification_state, epoch) {
	let delay = policy.safety_delay_ms(compiled, epoch, config.safety_interval);
	if (app_compiled.requested_enabled && app_compiled.next_transition != null) {
		const app_delay = (app_compiled.next_transition - epoch) * 1000;
		if (app_delay > 0 && app_delay < delay)
			delay = app_delay;
	}
	if (app_compiled.requested_enabled && classification_state.next_expiry != null) {
		const expiry_delay = (classification_state.next_expiry - epoch) * 1000;
		if (expiry_delay > 0 && expiry_delay < delay)
			delay = expiry_delay;
	}
	timer.set(delay);
}

function compile_runtime(config, epoch, tracking_required) {
	const monotonic_now = clock(true);
	const base_compiled = policy.compile(config, epoch);
	const base_app_compiled = app_policy.compile(config, epoch);
	const context = lease_context(base_app_compiled);
	const lease_state = refresh_lease_database(context, epoch, monotonic_now);
	const compiled = temporary_approval.overlay_access(base_compiled,
		lease_database);
	const app_compiled = temporary_approval.overlay_application(base_app_compiled,
		lease_database);
	const projection = model.project(compiled, config.bindings);
	const observation_context = prepare_observations(
		app_compiled.classification_model.signature);
	const classification_state = classification.resolve(
		app_compiled.classification_model,
		observation_context.observations,
		epoch,
		observation_context.generation,
		app_compiled.resource_limits);
	const subject_projection = model.project_subjects(app_compiled,
		config.bindings, tracking_required);
	const consistency = app_policy.consistency(compiled, app_compiled);
	return { base_compiled, compiled, projection, base_app_compiled,
		app_compiled, classification_state, observation_context,
		subject_projection, consistency, lease_state, context, monotonic_now };
}

function reconcile(reason, force) {
	ensure_dns_subscription();
	const epoch = clock()[0];
	const config = config_adapter.load();
	const runtime_offload = firewall.runtime_offload();
	const acceleration = runtime_policy.offload_capability(config,
		runtime_offload.checked, runtime_offload.ruleset, sfo_runtime.present());
	const runtime = compile_runtime(config, epoch, acceleration.tracking_required);
	const compiled = runtime.compiled;
	const projection = runtime.projection;
	const app_compiled = runtime.app_compiled;
	const classification_state = runtime.classification_state;
	const subject_projection = runtime.subject_projection;
	const authorization_snapshot = temporary_approval.effective_snapshot(
		compiled, app_compiled, app_compiled.enabled);
	const transition_reason = reconciliation.transition_reason(reason,
		runtime.lease_state);
	const planned_transitions = effective_authorization_snapshot == null
		? [] : temporary_approval.plan_transitions(
			effective_authorization_snapshot, authorization_snapshot,
			transition_reason);
	const source = compiled.enabled || app_compiled.requested_enabled ||
		acceleration.tracking_required
		? firewall.resolve_zones(config.source_zone)
		: { interfaces: [], errors: [] };
	const destination = compiled.enabled || app_compiled.requested_enabled ||
		acceleration.tracking_required
		? firewall.resolve_zones(config.destination_zone)
		: { interfaces: [], errors: [] };
	const signature = reconciliation.access_signature(compiled, projection,
		source.interfaces, destination.interfaces);
	let readiness_errors = compiled.enabled
		? [ ...source.errors, ...destination.errors ] : [];
	if (compiled.enabled && !length(source.interfaces))
		push(readiness_errors, 'No source interfaces resolved; enforcement is inactive');
	if (compiled.enabled && !length(destination.interfaces))
		push(readiness_errors, 'No destination interfaces resolved; enforcement is inactive');
	let errors = [ ...compiled.errors, ...projection.errors, ...readiness_errors ];
	let warnings = [ ...compiled.warnings, ...projection.warnings ];
	let apply = { ok: true, error: null };

	if (force || signature != applied_signature)
		apply = firewall.apply_access(compiled, projection, source.interfaces,
			destination.interfaces);
	if (apply.ok) {
		if (force || signature != applied_signature)
			generation++;
		applied_signature = signature;
	}
	else
		push(errors, apply.error);

	const previous_app_enforcement = app_runtime_state.applied_enforcement;
	let app_apply = application_reconcile.apply(app_runtime_state, config,
		app_compiled, classification_state,
		subject_projection, source.interfaces, destination.interfaces,
		[ ...source.errors, ...destination.errors ], force, observation_runtime,
		acceleration);
	let app_runtime = application_reconcile.runtime_snapshot(app_runtime_state,
		app_apply.tracking_enabled, app_apply.generation,
		app_apply.classifier_generation);
	if (app_apply.tracking_enabled && !app_runtime.available) {
		push(app_apply.errors, app_runtime.error ??
			'Application-filter runtime state became unavailable');
		application_reconcile.neutralize(app_runtime_state, app_apply.errors);
		app_apply = {
			...app_apply,
			ok: false,
			available: false,
			enabled: false,
			degraded: true,
			retained_previous_snapshot: false,
			backend_mode: 'V3_NFT_ONLY',
			tracking_enabled: false,
		};
	}
	else if (app_runtime.error)
		push(app_apply.warnings, app_runtime.error);
	for (let warning in runtime.consistency.warnings)
		push(app_apply.warnings, warning);
	if (app_apply.ok && app_apply.enabled)
		commit_observations(runtime.observation_context, epoch);

	let planned_broad_revocation = false;
	for (let transition in planned_transitions)
		if (transition.restrictive && transition.subject_id == null)
			planned_broad_revocation = true;
	if (acceleration.mode == 'SFO_ACTIVE' && !previous_app_enforcement &&
	    app_apply.enabled && !planned_broad_revocation)
		sfo_runtime_state.baseline_required = true;
	sfo_runtime_state = sfo_manager.reconcile(sfo_runtime_state, acceleration,
		app_apply.tracking_enabled && app_runtime.available &&
			app_runtime.correlation_healthy,
		config.sfo_revocation_deadline_ms);
	if (acceleration.mode == 'SFO_ACTIVE')
		sfo_runtime_state = sfo_manager.reconcile_gc(sfo_runtime_state,
			acceleration, app_apply.tracking_enabled && app_runtime.available &&
				app_runtime.correlation_healthy);
	else if (app_apply.tracking_enabled && app_runtime.available)
		bpf_runtime.gc(300);

	const app_publication_ok = !app_compiled.requested_enabled ||
		(app_apply.ok && app_apply.enabled);
	let transition_candidates = [], next_authorization_snapshot = {
		...(effective_authorization_snapshot ?? {}),
	};
	for (let key, entry in authorization_snapshot) {
		if ((entry.scope == 'access' && apply.ok) ||
		    (entry.scope == 'application' && app_publication_ok))
			next_authorization_snapshot[key] = entry;
	}
	for (let transition in planned_transitions) {
		const published_ok = transition.scope == 'access'
			? apply.ok : app_publication_ok;
		push(transition_candidates, {
			...transition,
			policy_generation: transition.scope == 'access'
				? generation : app_apply.generation,
			policy_published: published_ok,
		});
		if (transition.restrictive && !published_ok)
			push(errors,
				`Restrictive ${transition.scope} authorization transition could not be published`);
	}
	const published_transitions = sfo_manager.revoke_transitions(
		sfo_runtime_state, transition_candidates, acceleration);
	for (let transition in published_transitions)
		if (transition.restrictive && transition.revocation_state == 'failed')
			push(errors,
				`Restrictive ${transition.scope} transition did not revoke stale accelerated state`);
	if (apply.ok || app_publication_ok)
		effective_authorization_snapshot = next_authorization_snapshot;
	if (length(published_transitions))
		latest_authorization_transitions = published_transitions;
	if (!lease_transaction_active && lease_journal_dirty && apply.ok && app_publication_ok) {
		const journal = write_lease_journal(lease_database);
		if (!journal.ok)
			record_lease_errors([ journal.error ]);
	}

	const configuration_ready = compiled.schema_supported && compiled.mode_valid;
	const sfo_ready = !acceleration.offload_present ||
		sfo_runtime_state.mode == 'SFO_ACTIVE';
	const synchronized = apply.ok && configuration_ready &&
		!length(readiness_errors) && sfo_ready;
	const state_error = apply.error ??
		(length(readiness_errors) ? join('; ', readiness_errors) :
		 (!configuration_ready ? join('; ', compiled.errors) :
		 (!sfo_ready ? join('; ', sfo_runtime_state.errors) : null)));

	last_app_compiled = app_compiled;
	classification_conflicts = classification_state.semantic_state.conflict_count;
	state = {
		running: true,
		applied: synchronized,
		enabled: compiled.enabled,
		requested_enabled: compiled.requested_enabled,
		schema_supported: compiled.schema_supported,
		generation,
		last_reason: reason ?? 'unknown',
		last_attempt: epoch,
		last_success: synchronized ? epoch : state.last_success,
		last_error: state_error,
		next_transition: compiled.next_transition,
		clock_valid: compiled.clock_valid,
		mode: compiled.mode,
		deny_action: compiled.deny_action,
		default_verdict: compiled.default_verdict,
		exception_verdict: compiled.exception_verdict,
		identity_count: length(compiled.identities),
		active_identity_count: reconciliation.active_identity_count(compiled.identities),
		binding_count: projection.binding_count,
		exception_count: compiled.enabled ? length(projection.exceptions) : 0,
		source_interfaces: source.interfaces,
		destination_interfaces: destination.interfaces,
		errors,
		warnings,
		temporary_approvals: {
			active_count: length(lease_database.leases),
			capacity: temporary_approval.constants.MAX_ACTIVE_LEASES,
			next_expiry: temporary_approval.next_expiry(lease_database),
			journal_available: !lease_journal_dirty,
			latest_transitions: latest_authorization_transitions,
			errors: lease_journal_errors,
		},
		app_filter: {
			backend_mode: app_apply.backend_mode,
			requested_enabled: app_compiled.requested_enabled,
			enabled: app_apply.enabled,
			tracking_enabled: app_apply.tracking_enabled,
			degraded: app_apply.degraded,
			retained_previous_snapshot: app_apply.retained_previous_snapshot,
			available: app_apply.available,
			applied: app_apply.ok,
			app_policy_generation: app_apply.generation,
			classifier_generation: app_apply.classifier_generation,
			classifier_signature_count: classification_state.runtime_projection.signature_count,
			classifier_signature_memory_bytes: classification_state.runtime_projection.signature_memory_bytes,
			profile_count: app_compiled.classification_model.profile_count,
			classification_ir_entry_count: app_compiled.classification_model.ir_entry_count,
			semantic_entry_count: length(classification_state.semantic_state.entries),
			runtime_projection_entry_count: classification_state.runtime_projection.signature_count,
			provider_count: length(classification_state.semantic_state.provider_ids),
			resource_limits: app_compiled.resource_limits,
			runtime_available: app_runtime.available,
			runtime_status_json: app_runtime.status_json,
			dns_subscribed,
			observation_entries: observation_store.size(observation_runtime),
			observation_generation: observation_runtime.generation,
			observations_expired: observation_runtime.expired,
			observations_stale: observation_runtime.stale,
			dns_events_accepted: observation_runtime.accepted,
			dns_events_dropped: observation_runtime.dropped,
			classification_conflicts,
			projection_publish_errors,
			next_transition: app_compiled.next_transition,
			subject_count: length(app_compiled.identities),
			selector_count: length(subject_projection.preview_selectors),
			policy_entry_count: length(app_compiled.policies),
			errors: app_apply.errors,
			warnings: app_apply.warnings,
		},
		software_offload: { ...sfo_runtime_state },
	};

	update_timer(config, compiled, app_compiled, classification_state, epoch);
	return state;
}

function observation_snapshot(config) {
	const query = ubus.connect();
	if (!query)
		return { observations: [], error: 'Unable to query LuCI host hints' };
	const hints = query.call('luci-rpc', 'getHostHints', {}) ?? {};
	query.disconnect();

	let owners = {};
	for (let binding in config.bindings) {
		const mac = binding.type == 'mac' ? model.normalize_mac(binding.value) : null;
		if (!mac)
			continue;
		owners[mac] ??= [];
		push(owners[mac], binding.identity);
	}

	let observations = [];
	for (let raw_mac, hint in hints) {
		const mac = model.normalize_mac(raw_mac);
		if (!mac)
			continue;
		push(observations, {
			type: 'mac',
			value: mac,
			name: hint.name,
			ipaddrs: hint.ipaddrs ?? [],
			ip6addrs: hint.ip6addrs ?? [],
			bound: !!length(owners[mac] ?? []),
			identity_ids: unique_strings(owners[mac] ?? []),
		});
	}
	return { observations, error: null };
}

function identity_inventory() {
	const epoch = clock()[0];
	const config = config_adapter.load();
	const runtime = compile_runtime(config, epoch, false);
	const observed = observation_snapshot(config);
	let observation_by_mac = {}, binding_by_identity = {};
	for (let observation in observed.observations)
		observation_by_mac[observation.value] = observation;
	for (let binding in runtime.projection.bindings) {
		const observation = observation_by_mac[binding.value];
		binding_by_identity[binding.identity_id] ??= [];
		push(binding_by_identity[binding.identity_id], {
			section: binding.section,
			type: binding.type,
			value: binding.value,
			valid: binding.valid,
			error: binding.error,
			observed: !!observation,
			observed_name: observation ? observation.name : null,
			ipaddrs: observation ? observation.ipaddrs : [],
			ip6addrs: observation ? observation.ip6addrs : [],
		});
	}

	let identities = [];
	for (let identity in runtime.compiled.identities) {
		push(identities, {
			id: identity.id,
			name: identity.name,
			activation: identity.activation,
			base_verdict: identity.base_verdict,
			verdict: identity.verdict,
			verdict_source: identity.verdict_source,
			lease_id: identity.lease_id,
			lease_expires_at: identity.lease_expires_at,
			effective_active: identity.effective_active,
			reason: identity.reason,
			schedule_active: identity.schedule_active,
			next_transition: identity.next_transition,
			bindings: binding_by_identity[identity.id] ?? [],
		});
	}
	return {
		identities,
		mode: runtime.compiled.mode,
		default_verdict: runtime.compiled.default_verdict,
		exception_verdict: runtime.compiled.exception_verdict,
		clock: epoch,
		errors: [ ...runtime.compiled.errors, ...runtime.projection.errors ],
		error: observed.error,
	};
}

function observation_inventory() {
	const config = config_adapter.load();
	const observed = observation_snapshot(config);
	return { observations: observed.observations, clock: clock()[0], error: observed.error };
}

function approval_plane_published(result, scope) {
	if (scope == 'access')
		return result.applied;
	const application_published = result.app_filter.requested_enabled
		? result.app_filter.applied && result.app_filter.enabled
		: result.app_filter.applied;
	return application_published && result.applied;
}

function approval_inventory() {
	const epoch = clock()[0];
	const config = config_adapter.load();
	const runtime = compile_runtime(config, epoch, false);
	let effective_access = {};
	for (let identity in runtime.compiled.identities)
		effective_access[identity.id] = identity;
	let access_targets = [];
	for (let identity in runtime.base_compiled.identities) {
		const effective = effective_access[identity.id] ?? identity;
		let subject_id = null;
		for (let candidate in runtime.context.identities)
			if (candidate.id == identity.id)
				subject_id = candidate.subject_id;
		push(access_targets, {
			identity_id: identity.id,
			identity_name: identity.name,
			subject_id,
			base_verdict: identity.verdict,
			effective_verdict: effective.verdict,
			verdict_source: effective.verdict_source,
			lease_id: effective.lease_id,
			lease_expires_at: effective.lease_expires_at,
		});
	}

	let identity_names = {};
	for (let identity in runtime.base_app_compiled.identities)
		identity_names[identity.id] = identity.name;
	let application_targets = [], target_limit = 1024, truncated = false;
	for (let entry in runtime.app_compiled.policies) {
		if (entry.class_id <= temporary_approval.constants.CLASS_UNCLASSIFIED)
			continue;
		if (length(application_targets) >= target_limit) {
			truncated = true;
			break;
		}
		const class_info = runtime.app_compiled.classes['' + entry.class_id];
		push(application_targets, {
			identity_id: entry.identity_id,
			identity_name: identity_names[entry.identity_id],
			subject_id: entry.subject_id,
			class_id: entry.class_id,
			class_name: class_info ? class_info.name : null,
			class_kind: class_info ? class_info.kind : null,
			base_verdict: entry.base_verdict,
			effective_verdict: entry.verdict,
			verdict_source: entry.verdict_source,
			lease_id: entry.lease_id,
			lease_expires_at: entry.lease_expires_at,
		});
	}
	return {
		approvals: temporary_approval.list(lease_database, epoch,
			runtime.monotonic_now),
		active_count: length(lease_database.leases),
		capacity: temporary_approval.constants.MAX_ACTIVE_LEASES,
		next_expiry: temporary_approval.next_expiry(lease_database),
		journal_available: !lease_journal_dirty,
		access_available: runtime.base_compiled.enabled,
		application_available: runtime.base_app_compiled.enabled,
		access_targets,
		application_targets,
		application_targets_truncated: truncated,
		latest_transitions: latest_authorization_transitions,
		clock: epoch,
		clock_valid: runtime.base_compiled.clock_valid,
		errors: lease_journal_errors,
	};
}

function create_approval(message) {
	const epoch = clock()[0];
	const config = config_adapter.load();
	const runtime = compile_runtime(config, epoch, false);
	const scope = message.scope;
	if (scope == 'access' && !runtime.base_compiled.enabled)
		return { ok: false, errors: [ 'Internet access control is not active' ] };
	if (scope == 'application' && !runtime.base_app_compiled.enabled)
		return { ok: false, errors: [ 'Application filtering is not active' ] };

	const candidate = temporary_approval.create(lease_database, message,
		runtime.context, epoch, runtime.monotonic_now);
	if (!candidate.ok)
		return { ok: false, errors: candidate.errors };

	const previous = lease_database;
	lease_database = candidate.database;
	lease_journal_dirty = true;
	lease_transaction_active = true;
	const applied = reconcile(candidate.replacing ? 'lease_extended' : 'lease_created', false);
	const published_ok = approval_plane_published(applied, scope);
	let journal = { ok: false, error: 'Temporary Approval was not published' };
	if (published_ok)
		journal = write_lease_journal(lease_database);
	if (!published_ok || !journal.ok) {
		lease_database = previous;
		lease_journal_dirty = true;
		const rollback = reconcile('lease_rollback', false);
		const restored = approval_plane_published(rollback, scope);
		const restored_journal = write_lease_journal(previous);
		lease_transaction_active = false;
		return {
			ok: false,
			degraded: !restored || !restored_journal.ok,
			errors: [ journal.error ?? 'Temporary Approval projection failed' ],
		};
	}
	lease_transaction_active = false;
	return {
		ok: true,
		replacing: candidate.replacing,
		approval: temporary_approval.inspect(lease_database,
			candidate.lease.id, epoch, runtime.monotonic_now),
	};
}

function revoke_approval(lease_id) {
	const epoch = clock()[0];
	const runtime = compile_runtime(config_adapter.load(), epoch, false);
	const existing = temporary_approval.inspect(lease_database, lease_id,
		epoch, runtime.monotonic_now);
	if (!existing)
		return { ok: false, errors: [ `Unknown Temporary Approval '${lease_id}'` ] };
	const candidate = temporary_approval.revoke(lease_database, lease_id);
	if (!candidate.ok)
		return { ok: false, errors: candidate.errors };

	// Persist the restrictive source-of-truth change before publishing DENY.
	const journal = write_lease_journal(candidate.database);
	if (!journal.ok)
		return { ok: false, errors: [ journal.error ] };
	lease_database = candidate.database;
	lease_transaction_active = true;
	const applied = reconcile('lease_revoked', false);
	lease_transaction_active = false;
	const published_ok = approval_plane_published(applied, existing.scope);
	return published_ok
		? { ok: true, revoked: existing, transitions: latest_authorization_transitions }
		: { ok: false, revoked: existing, degraded: true,
			errors: [ 'Approval was removed, but restrictive runtime convergence failed' ] };
}

uloop.init();
conn = ubus.connect();
if (!conn) {
	warn('client-accessd: unable to connect to ubus\n');
	exit(1);
}

published = conn.publish('client_access', {
	status: {
		call: function() { return current_status(); },
	},
	preview: {
		call: function() {
			const epoch = clock()[0];
			const config = config_adapter.load();
			const runtime = compile_runtime(config, epoch, false);
			return {
				compiled: runtime.compiled,
				projection: runtime.projection,
				app_compiled: runtime.app_compiled,
				classification_state: runtime.classification_state,
				subject_projection: runtime.subject_projection,
				consistency: runtime.consistency,
				clock: epoch,
			};
		},
	},
	identities: {
		call: function() { return identity_inventory(); },
	},
	observations: {
		call: function() { return observation_inventory(); },
	},
	approvals: {
		call: function() { return approval_inventory(); },
	},
	approval: {
		args: { lease_id: 'string' },
		call: function(req, msg) {
			const epoch = clock()[0];
			const runtime = compile_runtime(config_adapter.load(), epoch, false);
			const value = temporary_approval.inspect(lease_database, msg.lease_id,
				epoch, runtime.monotonic_now);
			return value
				? { ok: true, approval: value }
				: { ok: false, errors: [ `Unknown Temporary Approval '${msg.lease_id}'` ] };
		},
	},
	approve: {
		args: {
			scope: 'string',
			identity_id: 'string',
			class_id: 'integer',
			duration: 'string',
		},
		call: function(req, msg) { return create_approval(msg); },
	},
	revoke_approval: {
		args: { lease_id: 'string' },
		call: function(req, msg) { return revoke_approval(msg.lease_id); },
	},
	reconcile: {
		args: { reason: 'string' },
		call: function(req, msg) { return reconcile(msg.reason ?? 'ubus', true); },
	},
});

if (!published) {
	warn('client-accessd: unable to publish ubus object\n');
	exit(1);
}

// Establish a known neutral cross-subsystem state before the first republish.
if (bpf_runtime.present())
	bpf_runtime.disable();
firewall.apply_application_scope(false, [], []);

// The safety wakeup also repairs runtime set loss after an out-of-band fw4 reload.
timer = uloop.timer(1, function() { reconcile('timer', true); });
uloop.run();
