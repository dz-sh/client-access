# V4.4 continuously authorizes every scoped packet. Established normal-path
# flows therefore observe ALLOW -> DENY on their next packet without conntrack
# deletion. Flow offload remains unsupported by the application workflow.
iifname @client_access_sources oifname @client_access_destinations jump client_access_dispatch

# Independent application-policy layer. Existing flows are intentionally
# evaluated so policy-generation changes take effect on their next packet.
iifname @client_access_app_sources oifname @client_access_app_destinations jump client_access_app_filter
