{
	"luci-app-client-access": {
		"description": "View LAN observations, identities, bindings, and Internet access policy",
		"read": {
			"ubus": {
				"client_access": [ "status", "preview", "identities", "observations", "approvals", "approval" ]
			},
			"uci": [ "client_access", "network", "firewall", "dhcp" ]
		},
		"write": {
			"ubus": {
				"client_access": [ "reconcile", "approve", "revoke_approval" ]
			},
			"uci": [ "client_access" ]
		}
	}
}
